{
  "name": "task-board",
  "private": true,
  "description": "Monorepo root: convenience scripts only. Each app has its own package.json.",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "backend:install": "npm --prefix backend install",
    "backend:dev": "npm --prefix backend run start:dev",
    "backend:migrate": "npm --prefix backend run migration:run",
    "backend:seed": "npm --prefix backend run seed",
    "backend:test": "npm --prefix backend test",
    "backend:test:e2e": "npm --prefix backend run test:e2e"
  }
}
