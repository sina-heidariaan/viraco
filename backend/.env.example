NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# Matches the root .env used by docker-compose.yml
DATABASE_URL=postgres://taskboard:taskboard@localhost:5433/taskboard

# SECURITY: replace this value. It is public (this file is in git), so anyone can use
# it to sign tokens as any user, including the owner. The backend still starts with it
# but logs a warning. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Must be true in production (HTTPS). Cookie path must match the Next.js proxy prefix.
COOKIE_SECURE=false
REFRESH_COOKIE_PATH=/api/v1/auth

# Seed users (npm run seed). Dev defaults are used when these are empty,
# except in production, where all three passwords are required.
SEED_OWNER_EMAIL=owner@taskboard.local
SEED_OWNER_PASSWORD=
SEED_MANAGER_EMAIL=manager@taskboard.local
SEED_MANAGER_PASSWORD=
SEED_MEMBER_EMAIL=member@taskboard.local
SEED_MEMBER_PASSWORD=
